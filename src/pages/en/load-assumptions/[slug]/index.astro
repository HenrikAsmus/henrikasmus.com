---
import { getCollection, render } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const alle = await getCollection('kapitel');
  const en = alle
    .filter(e => e.id.startsWith('en/'))
    .sort((a, b) => a.data.nummer - b.data.nummer);
  const de = alle.filter(e => e.id.startsWith('de/'));

  return en.map((entry, i) => {
    const slug = entry.id.replace(/^en\/\d+-/, '').replace(/\.md$/, '');
    const naechstes = en[i + 1] ?? null;
    const naechstesSlug = naechstes
      ? naechstes.id.replace(/^en\/\d+-/, '').replace(/\.md$/, '')
      : null;
    const deEntry = de.find(e => e.data.nummer === entry.data.nummer);
    const deSlug = deEntry
      ? deEntry.id.replace(/^de\/\d+-/, '').replace(/\.md$/, '')
      : null;

    return {
      params: { slug },
      props: { entry, naechstes, naechstesSlug, deSlug, alleEn: en },
    };
  });
}

const { entry, naechstes, naechstesSlug, deSlug, alleEn } = Astro.props;
const { Content } = await render(entry);
const slug = Astro.params.slug;

const kapitelLabel = entry.data.nummer === 0 ? 'Preface' : `Chapter ${entry.data.nummer}`;
const naechstesLabel = naechstes
  ? (naechstes.data.nummer === 0 ? 'Preface' : `Chapter ${naechstes.data.nummer}`)
  : null;

const chaptersJson = JSON.stringify(
  alleEn.map(e => ({
    label: e.data.nummer === 0 ? 'Preface' : `Chapter ${e.data.nummer}`,
    titel: e.data.titel,
    href: `/en/load-assumptions/${e.id.replace(/^en\/\d+-/, '').replace(/\.md$/, '')}/`,
  }))
);
---

<Layout
  title={`${entry.data.titel} — Load Assumptions`}
  lang="en"
  canonicalDE={deSlug ? `/lastannahmen/${deSlug}/` : '/lastannahmen/'}
  canonicalEN={`/en/load-assumptions/${slug}/`}
  description={entry.data.befund}
  breit
>
  <script type="application/json" id="__chapters" set:html={chaptersJson}></script>

  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/en/load-assumptions/">Load Assumptions</a>
    <span class="breadcrumb-sep" aria-hidden="true">/</span>
    <span>{kapitelLabel}</span>
  </nav>

  <p class="kapitel-nr">{kapitelLabel}</p>
  <h1 class="kapitel-titel">{entry.data.titel}</h1>

  <div class="kapitel-body">
    <Content />
  </div>

  {naechstes && naechstesSlug && (
    <nav class="kapitel-nav">
      <a href={`/en/load-assumptions/${naechstesSlug}/`} class="kapitel-weiter">
        Next: {naechstesLabel} — {naechstes.data.titel} →
      </a>
    </nav>
  )}

  <p class="back-link"><a href="/en/load-assumptions/">← Load Assumptions</a></p>
</Layout>
