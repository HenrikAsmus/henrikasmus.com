---
// V1A — "Grand": V1 aufgezogen. 780px, Name dominant, gestaffelte Einblendung,
// Stats-Streifen, PDFs als eigener Abschnitt, mehr Luft zwischen allen Segmenten.
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Henrik Asmus — V1A</title>
  <link rel="stylesheet" href="/styles/global.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    .wrap {
      max-width: 780px;
      margin: 0 auto;
      padding: 52px 28px 160px;
      font-family: 'Geist', Inter, system-ui, sans-serif;
      color: #121517;
    }

    /* Gestaffelte Einblendung */
    @media (prefers-reduced-motion: no-preference) {
      @keyframes fi { from { opacity: 0; } to { opacity: 1; } }
      .s0 { animation: fi 500ms ease both; }
      .s1 { animation: fi 500ms 80ms ease both; }
      .s2 { animation: fi 500ms 180ms ease both; }
      .s3 { animation: fi 500ms 290ms ease both; }
      .s4 { animation: fi 500ms 400ms ease both; }
    }

    /* Header */
    .head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 100px;
    }
    .lang {
      font-size: 11px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      display: flex;
      align-items: center;
    }
    .lang a { color: #B0B8BD; text-decoration: none; }
    .lang a.on { color: #121517; }
    .lang a:hover { color: #121517; }
    .lang-sl { color: #E0E4E7; margin: 0 7px; }

    /* Intro */
    .name {
      font-size: 62px;
      font-weight: 500;
      letter-spacing: -0.038em;
      line-height: 0.97;
      color: #121517;
      margin-bottom: 20px;
    }
    .sub {
      font-size: 16px;
      font-weight: 400;
      letter-spacing: -0.007em;
      line-height: 1.55;
      color: #8A9197;
    }

    /* Sektion-Label */
    .sec-label {
      font-size: 10.5px;
      font-weight: 400;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #C8CED2;
      margin-bottom: 28px;
    }

    /* Werk-Block */
    .werk { margin-top: 96px; }

    .t1 {
      display: block;
      font-size: 26px;
      font-weight: 500;
      letter-spacing: -0.032em;
      line-height: 1.18;
      color: #121517;
    }
    .t2 {
      display: block;
      font-size: 26px;
      font-weight: 500;
      letter-spacing: -0.032em;
      line-height: 1.18;
      background: linear-gradient(100deg, #78828A 0%, #C3CACF 50%, #78828A 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    /* Stats-Streifen */
    .stats {
      display: flex;
      flex-wrap: wrap;
      gap: 0 32px;
      margin-top: 20px;
    }
    .stats span {
      font-size: 12px;
      font-weight: 400;
      letter-spacing: 0.005em;
      color: #B8BFC4;
    }
    .stats span::before {
      content: '—';
      margin-right: 8px;
      color: #DDE1E4;
    }

    /* Abstract */
    .abstract-label {
      font-size: 10.5px;
      font-weight: 400;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #C8CED2;
      margin-top: 40px;
      margin-bottom: 16px;
    }
    .abstract {
      max-width: 620px;
      font-size: 15px;
      font-weight: 400;
      letter-spacing: -0.006em;
      line-height: 1.80;
      color: #61686E;
    }

    /* Links */
    .werk-links {
      margin-top: 32px;
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0 32px;
    }
    .werk-links a {
      font-size: 13px;
      font-weight: 400;
      letter-spacing: -0.004em;
      color: #121517;
      text-decoration: none;
    }
    .werk-links a:hover { text-decoration: underline; text-underline-offset: 3px; }
    .werk-links a.dim { color: #A4ABB0; }

    /* PDF-Abschnitt */
    .pdfs { margin-top: 96px; }
    .pdf-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      max-width: 560px;
    }
    .pdf-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .pdf-item a {
      font-size: 14px;
      font-weight: 500;
      letter-spacing: -0.008em;
      color: #121517;
      text-decoration: none;
    }
    .pdf-item a:hover { text-decoration: underline; text-underline-offset: 3px; }
    .pdf-item span {
      font-size: 12px;
      letter-spacing: 0.005em;
      color: #AAB1B6;
    }

    /* Kontakt */
    .contact { margin-top: 96px; }
    .email {
      font-size: 15px;
      font-weight: 400;
      letter-spacing: -0.007em;
      color: #121517;
      text-decoration: none;
    }
    .email:hover { text-decoration: underline; text-underline-offset: 3px; }

    @media (max-width: 639px) {
      .name { font-size: 40px; }
      .t1, .t2 { font-size: 20px; }
      .pdf-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
<div class="wrap">
  <div class="head s0">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
      <defs><linearGradient id="sga" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#D6DCE0"/><stop offset="45%" stop-color="#6E777E"/><stop offset="100%" stop-color="#AAB2B8"/>
      </linearGradient></defs>
      <path d="M10 3 L16.5 14 H3.5 Z" stroke="url(#sga)" stroke-width="1.4" stroke-linejoin="round" fill="none"/>
      <line x1="2" y1="17" x2="18" y2="17" stroke="url(#sga)" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
    <nav class="lang" aria-label="Sprache">
      <a href="/v1a/" class="on">DE</a><span class="lang-sl" aria-hidden="true">/</span><a href="/en/">EN</a>
    </nav>
  </div>

  <h1 class="name s1">Henrik Asmus</h1>
  <p class="sub s2">Student des Wirtschaftsingenieurwesens. Neugierig.</p>

  <div class="werk s3">
    <p class="sec-label">Arbeiten</p>
    <span class="t1">Lastannahmen</span>
    <span class="t2">Ethereum als fundamentale digitale Infrastruktur</span>
    <div class="stats">
      <span>Masterarbeit</span>
      <span>Eigenverlag</span>
      <span>Juli 2026</span>
      <span>324 Seiten</span>
    </div>
    <p class="abstract-label">Gegenstand</p>
    <p class="abstract">Die Arbeit prüft Ethereum an zwölf Kriterien für fundamentale Infrastruktur, in zwei Zuständen: im heutigen, Stand März 2026, und in dem, der sich bei vollständig umgesetzter Roadmap ergäbe. Sie ist an keiner Hochschule eingereicht. Geschrieben für Entscheider in Unternehmen, Kapitalgeber, technische Architekten und Politik, nicht für die Szene.</p>
    <div class="werk-links">
      <a href="/lastannahmen/">Zur Arbeit</a>
    </div>
  </div>

  <div class="pdfs s3">
    <p class="sec-label">Verfügbar als</p>
    <div class="pdf-grid">
      <div class="pdf-item">
        <a href="/pdf/Lastannahmen.pdf">Lastannahmen.pdf</a>
        <span>Deutsch · 324 Seiten</span>
      </div>
      <div class="pdf-item">
        <a href="/pdf/Load-Assumptions.pdf">Load-Assumptions.pdf</a>
        <span>English · 299 pages</span>
      </div>
    </div>
  </div>

  <div class="contact s4">
    <p class="sec-label">Kontakt</p>
    <a class="email" href="mailto:HenrikAsmus@proton.me">HenrikAsmus@proton.me</a>
  </div>
</div>
</body>
</html>
