---
export const prerender = false;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Load Assumptions</title>
  <meta name="description" content="Ethereum as Fundamental Digital Infrastructure — by Henrik Asmus" />
  <link rel="canonical" href="https://loadassumptions.xyz/en/" />
  <link rel="alternate" hreflang="de" href="https://loadassumptions.xyz/" />
  <link rel="alternate" hreflang="en" href="https://loadassumptions.xyz/en/" />
  <link rel="alternate" hreflang="x-default" href="https://loadassumptions.xyz/" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://loadassumptions.xyz/en/" />
  <meta property="og:title" content="Load Assumptions" />
  <meta property="og:description" content="Ethereum as Fundamental Digital Infrastructure — by Henrik Asmus" />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="Load Assumptions" />
  <meta name="twitter:description" content="Ethereum as Fundamental Digital Infrastructure — by Henrik Asmus" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/styles/global.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    .site-bar {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 13px 40px;
      background: rgba(255,255,255,0.96);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-bottom: 1px solid transparent;
      transition: border-color 0.2s ease;
    }
    .site-bar.scrolled { border-bottom-color: var(--c-divider); }
    @media (max-width: 639px) { .site-bar { padding: 13px 20px; } }

    /* ── Flag toggle ── */
    .lang-flip {
      position: relative;
      display: inline-flex;
      align-items: center;
      width: 68px;
      height: 32px;
      border-radius: 999px;
      background: rgba(0,0,0,0.04);
      border: 1px solid var(--c-divider);
      text-decoration: none;
      cursor: pointer;
      flex-shrink: 0;
      transition: border-color 0.15s;
    }
    .lang-flip:hover { border-color: var(--c-sub); }

    .lf-bg {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      opacity: 0.28;
      pointer-events: none;
      user-select: none;
      display: block;
      width: 18px;
      height: auto;
      border-radius: 2px;
    }
    .lf-bg-de { left: 7px; }
    .lf-bg-en { right: 7px; }

    .lf-knob {
      position: absolute;
      top: 2px;
      left: 2px;
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: #fff;
      box-shadow: 0 1px 4px rgba(0,0,0,0.18), 0 0 0 0.5px rgba(0,0,0,0.05);
      display: flex;
      align-items: center;
      justify-content: center;
      pointer-events: none;
      user-select: none;
      transition: left 0.22s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    }
    .lf-flag {
      display: block;
      width: 19px;
      height: auto;
      border-radius: 2px;
    }
    /* EN: knob slides to right: 68 - 2(border) - 2(gap) - 26(knob) = 38px */
    .lf-knob--en { left: 38px; }

    .hw {
      max-width: 860px;
      margin: 0 auto;
      padding: 88px 40px 160px;
      font-family: 'Geist', Inter, system-ui, sans-serif;
      color: var(--c-text);
    }
    @media (max-width: 639px) { .hw { padding: 64px 20px 120px; } }

    @media (prefers-reduced-motion: no-preference) {
      @keyframes fi { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
      .s1 { animation: fi 480ms 0ms ease both; }
      .s3 { animation: fi 480ms 200ms ease both; }
      .s4 { animation: fi 480ms 310ms ease both; }
    }

    .hero { margin-bottom: 96px; }

    .name {
      font-family: 'Pinyon Script', cursive;
      font-size: 96px;
      font-weight: 400;
      line-height: 1.0;
      letter-spacing: 0.01em;
      color: var(--c-text);
    }
    @media (max-width: 639px) { .name { font-size: 64px; } }

    .tagline {
      margin-top: 18px;
      font-size: 14.5px;
      letter-spacing: -0.006em;
      line-height: 1.55;
      color: var(--c-sub);
    }

    .sec-label {
      font-size: 9.5px;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      color: var(--c-meta);
      margin-bottom: 36px;
      display: block;
    }

    .werk-section { margin-bottom: 96px; }

    .werk-entry {
      border-top: 1px solid var(--c-divider);
      padding-top: 36px;
    }

    .werk-num { font-size: 10px; letter-spacing: 0.07em; color: var(--c-meta); padding-top: 5px; }

    .wt1, .wt2 {
      display: block;
      font-size: 26px;
      font-weight: 500;
      letter-spacing: -0.03em;
      line-height: 1.18;
    }
    .werk-body { position: relative; cursor: pointer; }
    .wt1 { color: var(--c-text); text-decoration: none; }
    .wt1::after { content: ''; position: absolute; inset: 0; }
    .werk-body:hover .wt1 { text-decoration: underline; text-underline-offset: 3px; }
    .werk-pdfs { position: relative; z-index: 1; }
    .wt2 {
      background: linear-gradient(90deg, #5F666C, #6F767C, #5F666C);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    @media (max-width: 639px) { .wt1, .wt2 { font-size: 20px; } }

    .werk-meta { margin-top: 14px; font-size: 12px; letter-spacing: 0.003em; color: var(--c-meta); }

    .werk-desc {
      margin-top: 16px;
      font-size: 14px;
      letter-spacing: -0.005em;
      line-height: 1.72;
      color: var(--c-body);
      max-width: 540px;
    }

    .werk-actions {
      margin-top: 24px;
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 6px 28px;
      position: relative;
      z-index: 1;
    }

    .werk-read { font-size: 13px; letter-spacing: -0.004em; color: var(--c-text); text-decoration: none; }
    .werk-read:hover { text-decoration: underline; text-underline-offset: 3px; }

    .werk-pdfs { display: flex; gap: 16px; flex-wrap: wrap; }
    .werk-pdf-a { font-size: 12px; letter-spacing: -0.002em; color: var(--c-meta); text-decoration: none; }
    .werk-pdf-a:hover { color: var(--c-sub); }

    .contact-section { border-top: 1px solid var(--c-divider); padding-top: 36px; }
    .contact-email {
      display: inline-block;
      margin-top: 14px;
      font-size: 14px;
      letter-spacing: -0.006em;
      color: var(--c-text);
      text-decoration: none;
    }
    .contact-email:hover { text-decoration: underline; text-underline-offset: 3px; }
  </style>
</head>
<body>

<div class="site-bar" id="site-bar">
  <a href="/" class="lang-flip" aria-label="Switch to German" onclick="document.cookie='lang=de;path=/;max-age=31536000;SameSite=Lax'">
    <img src="/flags/de.svg" class="lf-bg lf-bg-de" width="18" height="12" alt="" aria-hidden="true" />
    <img src="/flags/gb.svg" class="lf-bg lf-bg-en" width="18" height="12" alt="" aria-hidden="true" />
    <span class="lf-knob lf-knob--en" aria-hidden="true">
      <img src="/flags/gb.svg" class="lf-flag" width="19" height="13" alt="English" />
    </span>
  </a>
</div>

<div class="hw">
  <div class="hero s1">
    <h1 class="name">Henrik Asmus</h1>
    <p class="tagline">Student of industrial engineering.<br>Research on technology, infrastructure and capital.</p>
  </div>

  <section class="werk-section s3" aria-label="Works">
    <div class="werk-entry">
      <div class="werk-body">
        <a href="/en/load-assumptions/" class="wt1">Load Assumptions</a>
        <span class="wt2">Ethereum as Fundamental Digital Infrastructure</span>
        <p class="werk-meta">Self-published · July 2026 · 302 pages</p>
        <p class="werk-desc">The study examines Ethereum against twelve criteria for fundamental infrastructure, in two states: the current one as of March 2026, and the one that would result from full implementation of the roadmap. Written for corporate decision-makers, capital allocators, technical architects and policymakers.</p>
        <div class="werk-actions">
          <a href="/en/load-assumptions/" class="werk-read">Read online</a>
          <div class="werk-pdfs">
            <a href="/pdf/Lastannahmen.pdf" class="werk-pdf-a">PDF German</a>
            <a href="/pdf/Load-Assumptions.pdf" class="werk-pdf-a">PDF English</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-section s4" id="contact" aria-label="Contact">
    <a href="mailto:HenrikAsmus@proton.me" class="contact-email">HenrikAsmus@proton.me</a>
  </section>
</div>

<script is:inline>
  window.addEventListener('scroll', function () {
    var bar = document.getElementById('site-bar');
    if (bar) bar.classList.toggle('scrolled', window.scrollY > 16);
  }, { passive: true });
</script>
</body>
</html>
