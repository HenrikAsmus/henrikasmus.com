---
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Ragdoll Debug — Step 1</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #eee; font-family: 'Courier New', monospace; font-size: 12px;
           display: flex; gap: 20px; padding: 20px; }
    #wrap { flex: 0 0 auto; }
    svg#fig { background: #fff; border: 1px solid #bbb; display: block; }
    #panel { flex: 1; display: flex; flex-direction: column; gap: 10px; min-width: 380px; }
    #fps { font-size: 18px; font-weight: bold; }
    #warn { color: #c04000; font-weight: bold; font-size: 13px; min-height: 18px; }
    button { padding: 6px 16px; font-family: inherit; cursor: pointer;
             background: #222; color: #fff; border: none; }
    h3 { font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em;
         color: #888; margin-top: 4px; }
    .box { background: #fff; border: 1px solid #ccc; padding: 8px; }
    #pts { white-space: pre; font-size: 11px; line-height: 1.7; }
    #phys { font-size: 11px; line-height: 1.8; white-space: pre; }
    table { border-collapse: collapse; width: 100%; background: #fff;
            border: 1px solid #ccc; font-size: 11px; }
    td, th { padding: 2px 8px; border: 1px solid #ddd; text-align: right;
             font-variant-numeric: tabular-nums; }
    th { background: #e8e8e8; text-align: left; font-size: 10px; }
    td:first-child { text-align: left; }
    tr.gh td { background: #d8d8d8; font-weight: bold; font-size: 10px; color: #555; }
    .ok { color: #333; }
    .hi { color: #c04000; font-weight: bold; }
    .lo { color: #0040c0; font-weight: bold; }
    td.pk.hi { color: #c04000; font-weight: bold; }
    td.pk { color: #777; }
  </style>
</head>
<body>

<div id="wrap">
  <svg id="fig" viewBox="0 0 60 80" width="420" height="560"
       fill="none" xmlns="http://www.w3.org/2000/svg">
    <line x1="0" y1="79" x2="60" y2="79" stroke="#ccc" stroke-width="0.4"/>
  </svg>
</div>

<div id="panel">
  <div id="fps">FPS: —</div>
  <div id="warn"></div>
  <button id="nudgeBtn">Anstoßen (3 px/step)</button>

  <h3>Physik-Parameter</h3>
  <div class="box"><div id="phys">—</div></div>

  <h3>Punkte</h3>
  <div class="box"><div id="pts">—</div></div>

  <h3>Segmentlängen — Soll / Ist / Δ% / Peak Δ%</h3>
  <table>
    <thead><tr><th>Segment</th><th>Soll</th><th>Ist</th><th>Δ %</th><th>Peak</th></tr></thead>
    <tbody id="segTable"></tbody>
  </table>
</div>

<script>
(function () {
  'use strict';

  // ── Physics constants (displayed verbatim in debug panel) ─────────────────
  var GRAVITY  = 0.35;   // px / step²
  var DAMPING  = 0.98;
  var ITER     = 20;
  var STEP_MS  = 16.67;  // ms per fixed step  (≈ 60 steps/s)
  var NUDGE_V  = 3;      // px/step for button — gives max swing ≈ 57°

  // For 2 px/step init nudge:  max swing ≈ 38°  (well below horizontal)
  // For 3 px/step button nudge: max swing ≈ 57°  (clearly below horizontal)
  // Formula: cos(θ_max) = 1 − v²/(2·g·L_eff), L_eff ≈ 28 px (CoM to hands)
  var INIT_V   = 2;

  var NS = 'http://www.w3.org/2000/svg';

  function mk(x, y, pin) { return { x: x, y: y, px: x, py: y, pinned: !!pin }; }

  var p = {
    handL:     mk(22,  5, true),
    handR:     mk(38,  5, true),
    elbowL:    mk(21, 14),
    elbowR:    mk(39, 14),
    shoulderL: mk(25, 22),
    shoulderR: mk(35, 22),
    neck:      mk(30, 22),
    pelvis:    mk(30, 44),
    hipL:      mk(26, 44),
    hipR:      mk(34, 44),
    kneeL:     mk(24, 58),
    kneeR:     mk(36, 58),
    footL:     mk(24, 70),
    footR:     mk(36, 70),
  };

  var all = Object.values(p);

  function restLen(a, b) {
    var dx = b.x-a.x, dy = b.y-a.y;
    return Math.sqrt(dx*dx + dy*dy);
  }

  var HEAD_R      = restLen(p.neck, p.pelvis) * 0.25;
  var HEAD_OFFSET = HEAD_R + 1;

  // Named constraint definitions — order matters for convergence.
  // See: "Constraint resolution order" comment in ragdoll.js for rationale.
  var segDefs = [
    // 1. Torso first
    { g: 'Rumpf (zuerst)',        name: 'neck→pelvis',       a: p.neck,      b: p.pelvis    },
    // 2. Shoulder rigidity
    { g: 'Schulter-Rigidität',    name: 'neck→shoulderL',    a: p.neck,      b: p.shoulderL },
    { g: null,                    name: 'shoulderL→pelvis',  a: p.shoulderL, b: p.pelvis    },
    { g: null,                    name: 'neck→shoulderR',    a: p.neck,      b: p.shoulderR },
    { g: null,                    name: 'shoulderR→pelvis',  a: p.shoulderR, b: p.pelvis    },
    // 3. Hip rigidity
    { g: 'Hüft-Rigidität',       name: 'pelvis→hipL',       a: p.pelvis,    b: p.hipL      },
    { g: null,                    name: 'hipL→neck',         a: p.hipL,      b: p.neck      },
    { g: null,                    name: 'pelvis→hipR',       a: p.pelvis,    b: p.hipR      },
    { g: null,                    name: 'hipR→neck',         a: p.hipR,      b: p.neck      },
    // 4. Legs
    { g: 'Beine',                 name: 'hipL→kneeL',        a: p.hipL,      b: p.kneeL     },
    { g: null,                    name: 'hipR→kneeR',        a: p.hipR,      b: p.kneeR     },
    { g: null,                    name: 'kneeL→footL',       a: p.kneeL,     b: p.footL     },
    { g: null,                    name: 'kneeR→footR',       a: p.kneeR,     b: p.footR     },
    // 5. Arms LAST — elbow→shoulder first, then hand→elbow as very last.
    //    handL/R→elbowL/R must be solved AFTER elbowL/R→shoulderL/R so that
    //    the final operation on each elbow is a full pinned-hand correction → 0 % error.
    { g: 'Arme (Schulter zuerst, Hand ganz zuletzt)', name: 'elbowL→shoulderL', a: p.elbowL, b: p.shoulderL },
    { g: null,                    name: 'elbowR→shoulderR',  a: p.elbowR,    b: p.shoulderR },
    { g: null,                    name: 'handL→elbowL',      a: p.handL,     b: p.elbowL    },
    { g: null,                    name: 'handR→elbowR',      a: p.handR,     b: p.elbowR    },
  ];

  var C = segDefs.map(function (s) {
    return [s.a, s.b, restLen(s.a, s.b)];
  });

  var peakDev = segDefs.map(function () { return 0; });

  function nudge(v) {
    all.forEach(function (q) { if (!q.pinned) q.px -= (v || NUDGE_V); });
    peakDev = peakDev.map(function () { return 0; });
    document.getElementById('warn').textContent = '';
  }

  nudge(INIT_V);

  function integrate() {
    for (var i = 0; i < all.length; i++) {
      var q = all[i];
      if (q.pinned) continue;
      var vx = (q.x-q.px)*DAMPING, vy = (q.y-q.py)*DAMPING;
      q.px = q.x; q.py = q.y;
      q.x += vx; q.y += vy + GRAVITY;
    }
  }

  function solve() {
    for (var it = 0; it < ITER; it++) {
      for (var c = 0; c < C.length; c++) {
        var a = C[c][0], b = C[c][1], r = C[c][2];
        var dx = b.x-a.x, dy = b.y-a.y;
        var dist = Math.sqrt(dx*dx + dy*dy) || 1e-9;
        var corr = (dist-r)/dist;
        if (a.pinned && b.pinned) {
          continue;
        } else if (a.pinned) {
          b.x -= dx*corr; b.y -= dy*corr;
        } else if (b.pinned) {
          a.x += dx*corr; a.y += dy*corr;
        } else {
          var h = corr*0.5;
          a.x += dx*h; a.y += dy*h;
          b.x -= dx*h; b.y -= dy*h;
        }
      }
    }
  }

  // ── SVG setup ─────────────────────────────────────────────────────────────
  var svg = document.getElementById('fig');

  function mkLine(stroke, w) {
    var el = document.createElementNS(NS, 'line');
    el.setAttribute('stroke', stroke || '#121517');
    el.setAttribute('stroke-width', String(w || 2));
    el.setAttribute('stroke-linecap', 'round');
    svg.appendChild(el);
    return el;
  }

  function mkPath() {
    var el = document.createElementNS(NS, 'path');
    el.setAttribute('stroke', '#121517');
    el.setAttribute('stroke-width', '2');
    el.setAttribute('stroke-linecap', 'round');
    el.setAttribute('stroke-linejoin', 'round');
    el.setAttribute('fill', 'none');
    svg.appendChild(el);
    return el;
  }

  var headEl = document.createElementNS(NS, 'circle');
  headEl.setAttribute('stroke', '#121517');
  headEl.setAttribute('stroke-width', '2');
  headEl.setAttribute('fill', 'none');
  svg.appendChild(headEl);

  // Torso as straight lines; limbs as quadratic Bézier paths
  var L = {
    shoulderBar: mkLine(), spine: mkLine(), hipBar: mkLine(),
    armL: mkPath(), armR: mkPath(),
    legL: mkPath(), legR: mkPath(),
  };

  // Debug constraint lines (colored by stretch)
  var cLines = C.map(function () {
    var el = document.createElementNS(NS, 'line');
    el.setAttribute('stroke-width', '0.5');
    el.setAttribute('stroke-linecap', 'round');
    el.setAttribute('opacity', '0.55');
    svg.appendChild(el);
    return el;
  });

  // Debug point dots + labels
  var ptNames = Object.keys(p);
  var ptDots = {}, ptLabels = {};
  ptNames.forEach(function (name) {
    var dot = document.createElementNS(NS, 'circle');
    dot.setAttribute('r', '1.2');
    dot.setAttribute('fill', p[name].pinned ? '#e00' : '#f90');
    dot.setAttribute('stroke', 'none');
    svg.appendChild(dot);
    ptDots[name] = dot;
    var lbl = document.createElementNS(NS, 'text');
    lbl.setAttribute('font-size', '2.2');
    lbl.setAttribute('fill', '#555');
    lbl.setAttribute('font-family', 'monospace');
    svg.appendChild(lbl);
    ptLabels[name] = lbl;
  });

  function setLine(el, a, b) {
    el.setAttribute('x1', a.x.toFixed(2)); el.setAttribute('y1', a.y.toFixed(2));
    el.setAttribute('x2', b.x.toFixed(2)); el.setAttribute('y2', b.y.toFixed(2));
  }

  function qbez(el, P0, ctrl, P2) {
    el.setAttribute('d',
      'M ' + P0.x.toFixed(2) + ' ' + P0.y.toFixed(2) +
      ' Q ' + ctrl.x.toFixed(2) + ' ' + ctrl.y.toFixed(2) +
      ' ' + P2.x.toFixed(2) + ' ' + P2.y.toFixed(2));
  }

  function render() {
    var tx = p.neck.x-p.pelvis.x, ty = p.neck.y-p.pelvis.y;
    var tl = Math.sqrt(tx*tx + ty*ty) || 1;
    headEl.setAttribute('cx', (p.neck.x + tx/tl*HEAD_OFFSET).toFixed(2));
    headEl.setAttribute('cy', (p.neck.y + ty/tl*HEAD_OFFSET).toFixed(2));
    headEl.setAttribute('r',  HEAD_R.toFixed(1));

    setLine(L.shoulderBar, p.shoulderL, p.shoulderR);
    setLine(L.spine,       p.neck,      p.pelvis);
    setLine(L.hipBar,      p.hipL,      p.hipR);
    // Limbs: M endpoint Q joint(control) endpoint2
    qbez(L.armL, p.handL, p.elbowL, p.shoulderL);
    qbez(L.armR, p.handR, p.elbowR, p.shoulderR);
    qbez(L.legL, p.footL, p.kneeL,  p.hipL);
    qbez(L.legR, p.footR, p.kneeR,  p.hipR);

    C.forEach(function (c, i) {
      var dx = c[1].x-c[0].x, dy = c[1].y-c[0].y;
      var cur = Math.sqrt(dx*dx+dy*dy);
      var dev = (cur-c[2])/c[2];
      var col = Math.abs(dev)<0.02 ? '#888' : (dev>0 ? '#e06000' : '#0060e0');
      cLines[i].setAttribute('stroke', col);
      setLine(cLines[i], c[0], c[1]);
    });

    ptNames.forEach(function (name) {
      var q = p[name];
      ptDots[name].setAttribute('cx', q.x.toFixed(2));
      ptDots[name].setAttribute('cy', q.y.toFixed(2));
      ptLabels[name].setAttribute('x', (q.x+1.5).toFixed(2));
      ptLabels[name].setAttribute('y', (q.y-0.5).toFixed(2));
      ptLabels[name].textContent = name;
    });
  }

  // ── Stats panel ───────────────────────────────────────────────────────────
  var fpsEl    = document.getElementById('fps');
  var physEl   = document.getElementById('phys');
  var ptsEl    = document.getElementById('pts');
  var tbody    = document.getElementById('segTable');
  var warnEl   = document.getElementById('warn');

  document.getElementById('nudgeBtn').addEventListener('click', function () { nudge(NUDGE_V); });

  // Pendulum swing angle estimate for button nudge
  var L_eff = 28; // approximate CoM-to-hands distance (px)
  var cosTh = 1 - (NUDGE_V*NUDGE_V)/(2*GRAVITY*L_eff);
  var thetaDeg = (Math.acos(Math.max(-1, cosTh)) * 180 / Math.PI).toFixed(0);

  physEl.textContent =
    'GRAVITY    : ' + GRAVITY.toFixed(2) + ' px/step²\n' +
    'DAMPING    : ' + DAMPING.toFixed(2) + '\n' +
    'ITER       : ' + ITER + ' per frame\n' +
    'STEP_MS    : ' + STEP_MS.toFixed(2) + ' ms  (≈60 steps/s)\n' +
    'INIT_NUDGE : ' + INIT_V + ' px/step rightward  (~' +
      (function(){
        var c=1-(INIT_V*INIT_V)/(2*GRAVITY*L_eff);
        return (Math.acos(Math.max(-1,c))*180/Math.PI).toFixed(0);
      })() + '° max swing)\n' +
    'BTN_NUDGE  : ' + NUDGE_V + ' px/step rightward  (~' + thetaDeg + '° max swing)\n' +
    'L_eff      : ~' + L_eff + ' px  (hands→CoM, used for swing estimate)';

  var segRows = [];
  segDefs.forEach(function (s, i) {
    if (s.g) {
      var gh = document.createElement('tr');
      gh.className = 'gh';
      gh.innerHTML = '<td colspan="5">' + s.g + '</td>';
      tbody.appendChild(gh);
    }
    var tr = document.createElement('tr');
    tr.innerHTML = '<td>' + s.name + '</td>' +
                   '<td>' + C[i][2].toFixed(2) + '</td>' +
                   '<td class="cur ok">—</td>' +
                   '<td class="dev ok">—</td>' +
                   '<td class="pk">—</td>';
    tbody.appendChild(tr);
    segRows.push(tr);
  });

  var fpsN = 0, fpsA = 0, fpsL = 0;

  function updateStats(ts) {
    fpsN++; fpsA += ts-(fpsL||ts); fpsL = ts;
    if (fpsA >= 500) {
      fpsEl.textContent = 'FPS: ' + Math.round(fpsN/fpsA*1000);
      fpsN = 0; fpsA = 0;
    }

    // Current neck velocity (for live swing monitoring)
    var vnx = (p.neck.x - p.neck.px).toFixed(2);
    var vny = (p.neck.y - p.neck.py).toFixed(2);

    ptsEl.textContent = ptNames.map(function (n) {
      var q = p[n];
      return (n + (q.pinned ? ' [PIN]' : '      ')).padEnd(14) +
             'x=' + q.x.toFixed(1).padStart(5) + '  y=' + q.y.toFixed(1).padStart(5);
    }).join('\n') + '\n\nneck vx=' + vnx + '  vy=' + vny;

    var anyOver = false;
    segDefs.forEach(function (s, i) {
      var r = C[i][2];
      var dx = s.b.x-s.a.x, dy = s.b.y-s.a.y;
      var cur = Math.sqrt(dx*dx+dy*dy);
      var dev = (cur-r)/r*100;
      var abs = Math.abs(dev);
      if (abs > peakDev[i]) peakDev[i] = abs;
      if (peakDev[i] >= 2) anyOver = true;
      var cls = abs < 2 ? 'ok' : (dev > 0 ? 'hi' : 'lo');
      var curTd = segRows[i].querySelector('.cur');
      var devTd = segRows[i].querySelector('.dev');
      var pkTd  = segRows[i].querySelector('.pk');
      curTd.textContent = cur.toFixed(2); curTd.className = 'cur ' + cls;
      devTd.textContent = (dev>=0?'+':'') + dev.toFixed(1) + '%'; devTd.className = 'dev ' + cls;
      pkTd.textContent  = peakDev[i].toFixed(1) + '%';
      pkTd.className    = 'pk' + (peakDev[i] >= 2 ? ' hi' : '');
    });
    warnEl.textContent = anyOver ? '⚠ Peak über 2 % — Reihenfolge oder Impuls prüfen' : '';
  }

  // ── Main loop ─────────────────────────────────────────────────────────────
  var acc = 0, lastT = null, rafId = null;

  function loop(ts) {
    rafId = requestAnimationFrame(loop);
    if (!lastT) { lastT = ts; }
    var dt = Math.min(ts-lastT, 200);
    lastT = ts;
    acc += dt;
    while (acc >= STEP_MS) { integrate(); solve(); acc -= STEP_MS; }
    render();
    updateStats(ts);
  }

  rafId = requestAnimationFrame(loop);

  document.addEventListener('visibilitychange', function () {
    if (document.hidden) { cancelAnimationFrame(rafId); rafId = null; }
    else { lastT = null; rafId = requestAnimationFrame(loop); }
  });
})();
</script>
</body>
</html>
