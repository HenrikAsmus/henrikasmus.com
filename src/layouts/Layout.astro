---
interface Props {
  title: string;
  lang: 'de' | 'en';
  canonicalDE: string;
  canonicalEN: string;
  breit?: boolean;
}
const { title, lang, canonicalDE, canonicalEN, breit = false } = Astro.props;
const base = 'https://henrikasmus.com';
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <link rel="canonical" href={lang === 'de' ? `${base}${canonicalDE}` : `${base}${canonicalEN}`} />
  <link rel="alternate" hreflang="de" href={`${base}${canonicalDE}`} />
  <link rel="alternate" hreflang="en" href={`${base}${canonicalEN}`} />
  <link rel="alternate" hreflang="x-default" href={`${base}${canonicalDE}`} />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <main class={breit ? 'kapitel-column' : 'column'}>
    <header class="header">
      <svg
        class="symbol"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 20 20"
        width="18"
        height="18"
        aria-hidden="true"
        fill="none"
      >
        <defs>
          <linearGradient id="sg" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%"   stop-color="#D6DCE0" />
            <stop offset="45%"  stop-color="#6E777E" />
            <stop offset="100%" stop-color="#AAB2B8" />
          </linearGradient>
        </defs>
        <path
          d="M10 3 L16.5 14 H3.5 Z"
          stroke="url(#sg)"
          stroke-width="1.4"
          stroke-linejoin="round"
          fill="none"
        />
        <line
          x1="2" y1="17" x2="18" y2="17"
          stroke="url(#sg)"
          stroke-width="1.4"
          stroke-linecap="round"
        />
      </svg>

      <nav class="lang-switcher" aria-label="Sprache / Language">
        <a href={canonicalDE} class={lang === 'de' ? 'active' : ''} aria-label="Deutsch">DE</a>
        <span class="slash" aria-hidden="true">/</span>
        <a href={canonicalEN} class={lang === 'en' ? 'active' : ''} aria-label="English">EN</a>
      </nav>
    </header>

    <slot />
  </main>
</body>
</html>
