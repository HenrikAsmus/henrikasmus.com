---
// V1B — "Split": Name groß oben, Werk-Eintrag im Zwei-Spalten-Grid.
// Titel/Meta links, Abstract/Links rechts. Magazin-Charakter, 840px.
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Henrik Asmus — V1B</title>
  <link rel="stylesheet" href="/styles/global.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    .wrap {
      max-width: 840px;
      margin: 0 auto;
      padding: 52px 28px 160px;
      font-family: 'Geist', Inter, system-ui, sans-serif;
      color: #121517;
    }

    @media (prefers-reduced-motion: no-preference) {
      @keyframes fi { from { opacity: 0; } to { opacity: 1; } }
      .s0 { animation: fi 450ms ease both; }
      .s1 { animation: fi 450ms 100ms ease both; }
      .s2 { animation: fi 450ms 220ms ease both; }
      .s3 { animation: fi 450ms 340ms ease both; }
    }

    /* Header */
    .head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 88px;
    }
    .lang {
      font-size: 11px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      display: flex;
      align-items: center;
    }
    .lang a { color: #B0B8BD; text-decoration: none; }
    .lang a.on { color: #121517; }
    .lang a:hover { color: #121517; }
    .lang-sl { color: #E0E4E7; margin: 0 7px; }

    /* Intro — voll breit */
    .intro { margin-bottom: 80px; }
    .name {
      font-size: 54px;
      font-weight: 500;
      letter-spacing: -0.036em;
      line-height: 1.0;
      color: #121517;
      margin-bottom: 18px;
    }
    .sub {
      font-size: 15px;
      font-weight: 400;
      letter-spacing: -0.006em;
      line-height: 1.55;
      color: #8A9197;
      max-width: 460px;
    }

    /* Sektion-Zeile */
    .sec-row {
      display: flex;
      align-items: baseline;
      gap: 0 20px;
      margin-bottom: 36px;
    }
    .sec-label {
      font-size: 10.5px;
      font-weight: 400;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #C8CED2;
      flex-shrink: 0;
    }
    .sec-line {
      flex: 1;
      height: 1px;
      background: #F0F3F5;
      position: relative;
      top: -3px;
    }

    /* Split-Grid */
    .split {
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: 0 56px;
      align-items: start;
    }

    /* Linke Spalte */
    .split-left { padding-top: 2px; }

    .t1 {
      display: block;
      font-size: 21px;
      font-weight: 500;
      letter-spacing: -0.03em;
      line-height: 1.22;
      color: #121517;
    }
    .t2 {
      display: block;
      font-size: 21px;
      font-weight: 500;
      letter-spacing: -0.03em;
      line-height: 1.22;
      background: linear-gradient(100deg, #78828A 0%, #C3CACF 50%, #78828A 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .meta-block {
      margin-top: 24px;
      display: flex;
      flex-direction: column;
      gap: 5px;
    }
    .meta-row {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      letter-spacing: 0;
      color: #AAB1B6;
    }
    .meta-row span:first-child { color: #C8CED2; font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; }

    /* Rechte Spalte */
    .split-right {}

    .abstract {
      font-size: 15px;
      font-weight: 400;
      letter-spacing: -0.006em;
      line-height: 1.78;
      color: #61686E;
    }

    .split-links {
      margin-top: 28px;
      display: flex;
      flex-wrap: wrap;
      gap: 0 28px;
    }
    .split-links a {
      font-size: 13px;
      font-weight: 400;
      letter-spacing: -0.004em;
      color: #121517;
      text-decoration: none;
    }
    .split-links a:hover { text-decoration: underline; text-underline-offset: 3px; }
    .split-links a.dim { color: #A4ABB0; }

    /* PDF-Spalten */
    .pdf-split {
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: 0 56px;
      align-items: start;
      margin-top: 64px;
    }
    .pdf-left { padding-top: 2px; }
    .pdf-desc {
      font-size: 13px;
      font-weight: 400;
      letter-spacing: -0.005em;
      line-height: 1.6;
      color: #9BA2A8;
    }
    .pdf-right {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .pdf-item {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
    }
    .pdf-item a {
      font-size: 14px;
      font-weight: 500;
      letter-spacing: -0.007em;
      color: #121517;
      text-decoration: none;
    }
    .pdf-item a:hover { text-decoration: underline; text-underline-offset: 3px; }
    .pdf-item span {
      font-size: 12px;
      letter-spacing: 0.005em;
      color: #B8BFC4;
    }

    /* Kontakt */
    .contact-split {
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: 0 56px;
      align-items: start;
      margin-top: 64px;
    }
    .email {
      font-size: 15px;
      font-weight: 400;
      letter-spacing: -0.007em;
      color: #121517;
      text-decoration: none;
    }
    .email:hover { text-decoration: underline; text-underline-offset: 3px; }

    @media (max-width: 760px) {
      .split, .pdf-split, .contact-split {
        grid-template-columns: 1fr;
        gap: 24px 0;
      }
      .name { font-size: 38px; }
    }
  </style>
</head>
<body>
<div class="wrap">
  <div class="head s0">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
      <defs><linearGradient id="sgb" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#D6DCE0"/><stop offset="45%" stop-color="#6E777E"/><stop offset="100%" stop-color="#AAB2B8"/>
      </linearGradient></defs>
      <path d="M10 3 L16.5 14 H3.5 Z" stroke="url(#sgb)" stroke-width="1.4" stroke-linejoin="round" fill="none"/>
      <line x1="2" y1="17" x2="18" y2="17" stroke="url(#sgb)" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
    <nav class="lang" aria-label="Sprache">
      <a href="/v1b/" class="on">DE</a><span class="lang-sl" aria-hidden="true">/</span><a href="/en/">EN</a>
    </nav>
  </div>

  <div class="intro s1">
    <h1 class="name">Henrik Asmus</h1>
    <p class="sub">Student des Wirtschaftsingenieurwesens. Neugierig.</p>
  </div>

  <div class="s2">
    <div class="sec-row">
      <span class="sec-label">Arbeiten</span>
      <div class="sec-line" aria-hidden="true"></div>
    </div>

    <div class="split">
      <div class="split-left">
        <span class="t1">Lastannahmen</span>
        <span class="t2">Ethereum als fundamentale digitale Infrastruktur</span>
        <div class="meta-block">
          <div class="meta-row"><span>Format</span><span>Masterarbeit</span></div>
          <div class="meta-row"><span>Verlag</span><span>Eigenverlag</span></div>
          <div class="meta-row"><span>Datum</span><span>Juli 2026</span></div>
          <div class="meta-row"><span>Umfang</span><span>324 Seiten</span></div>
        </div>
      </div>
      <div class="split-right">
        <p class="abstract">Die Arbeit prüft Ethereum an zwölf Kriterien für fundamentale Infrastruktur, in zwei Zuständen: im heutigen, Stand März 2026, und in dem, der sich bei vollständig umgesetzter Roadmap ergäbe. Sie ist an keiner Hochschule eingereicht. Geschrieben für Entscheider in Unternehmen, Kapitalgeber, technische Architekten und Politik, nicht für die Szene.</p>
        <div class="split-links">
          <a href="/lastannahmen/">Zur Arbeit</a>
        </div>
      </div>
    </div>

    <div class="pdf-split">
      <div class="pdf-left">
        <p class="pdf-desc">Beide Fassungen als PDF</p>
      </div>
      <div class="pdf-right">
        <div class="pdf-item">
          <a href="/pdf/Lastannahmen.pdf">Lastannahmen.pdf</a>
          <span>Deutsch · 324 Seiten</span>
        </div>
        <div class="pdf-item">
          <a href="/pdf/Load-Assumptions.pdf">Load-Assumptions.pdf</a>
          <span>English · 299 pages</span>
        </div>
      </div>
    </div>
  </div>

  <div class="s3">
    <div class="sec-row" style="margin-top: 72px;">
      <span class="sec-label">Kontakt</span>
      <div class="sec-line" aria-hidden="true"></div>
    </div>
    <div class="contact-split">
      <div></div>
      <div>
        <a class="email" href="mailto:HenrikAsmus@proton.me">HenrikAsmus@proton.me</a>
      </div>
    </div>
  </div>
</div>
</body>
</html>
