---
// V1D — Aufbauend auf v1c: Symbol als eigenständige Zone, Name 68px,
// Laufnummer mit Gradientfarbe, Gradient-Akzentlinie auf Kachel,
// strukturelle Zahlen der Arbeit als Subzeile, Zielgruppen-Leiste.
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Henrik Asmus — V1D</title>
  <link rel="stylesheet" href="/styles/global.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body { background: #FFFFFF; }

    .wrap {
      max-width: 760px;
      margin: 0 auto;
      padding: 56px 28px 160px;
      font-family: 'Geist', Inter, system-ui, sans-serif;
      color: #121517;
    }

    /* Gestaffelte Einblendung */
    @media (prefers-reduced-motion: no-preference) {
      @keyframes fi { from { opacity: 0; } to { opacity: 1; } }
      .s0 { animation: fi 420ms ease both; }
      .s1 { animation: fi 420ms 60ms ease both; }
      .s2 { animation: fi 420ms 140ms ease both; }
      .s3 { animation: fi 420ms 230ms ease both; }
      .s4 { animation: fi 420ms 330ms ease both; }
      .s5 { animation: fi 420ms 440ms ease both; }
    }

    /* ── Kopfzeile ───────────────────────────────────────── */
    .head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 64px;
    }
    .lang {
      font-size: 11px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      display: flex;
      align-items: center;
    }
    .lang a { color: #B0B8BD; text-decoration: none; }
    .lang a.on { color: #121517; }
    .lang a:hover { color: #121517; }
    .lang-sl { color: #E0E4E7; margin: 0 7px; }

    /* ── Symbol als eigene Zone ──────────────────────────── */
    .symbol-zone {
      margin-bottom: 24px;
    }

    /* ── Intro ───────────────────────────────────────────── */
    .name {
      font-size: 68px;
      font-weight: 500;
      letter-spacing: -0.040em;
      line-height: 0.95;
      color: #121517;
    }
    .tagline {
      margin-top: 20px;
      font-size: 17px;
      font-weight: 400;
      letter-spacing: -0.009em;
      line-height: 1.5;
      color: #8A9197;
    }

    /* Strukturelle Zahlen der Arbeit */
    .thesis-spec {
      margin-top: 14px;
      display: flex;
      align-items: center;
      gap: 0;
      font-size: 11px;
      font-weight: 400;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #C8CED2;
    }
    .thesis-spec span + span::before {
      content: '·';
      margin: 0 10px;
      color: #E2E5E8;
    }

    /* ── Sektion ─────────────────────────────────────────── */
    .werk { margin-top: 88px; }

    .werk-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 16px;
    }
    .sec-label {
      font-size: 10.5px;
      font-weight: 400;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #C8CED2;
    }
    .werk-year {
      font-size: 12px;
      font-weight: 400;
      color: #C8CED2;
    }

    /* ── Kachel ──────────────────────────────────────────── */
    .werk-card {
      border: 1px solid #ECEEF0;
      border-radius: 10px;
      overflow: hidden; /* damit ::before nicht übersteht */
    }

    /* Gradient-Akzentlinie oben */
    .werk-card::before {
      content: '';
      display: block;
      height: 2px;
      background: linear-gradient(100deg, #78828A 0%, #C3CACF 50%, #78828A 100%);
    }

    .card-inner {
      padding: 26px 28px 24px;
    }

    /* Hover: Titel minimal dunkler */
    .werk-card:hover .t1 { color: #000000; }

    /* Laufnummer + Titel */
    .title-row {
      display: flex;
      align-items: baseline;
      gap: 10px;
      margin-bottom: 2px;
    }
    .work-index {
      font-size: 12px;
      font-weight: 400;
      letter-spacing: 0.02em;
      background: linear-gradient(100deg, #78828A 0%, #C3CACF 50%, #78828A 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      flex-shrink: 0;
      position: relative;
      top: -1px;
    }
    .t1 {
      font-size: 24px;
      font-weight: 500;
      letter-spacing: -0.032em;
      line-height: 1.2;
      color: #121517;
      transition: color 120ms;
    }
    .t2 {
      display: block;
      font-size: 24px;
      font-weight: 500;
      letter-spacing: -0.032em;
      line-height: 1.2;
      background: linear-gradient(100deg, #78828A 0%, #C3CACF 50%, #78828A 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      margin-left: 22px; /* bündig unter t1, nach dem Index */
    }

    /* Meta */
    .meta-strip {
      margin-top: 16px;
      display: flex;
      flex-wrap: wrap;
    }
    .meta-strip span {
      font-size: 12px;
      font-weight: 400;
      letter-spacing: 0.005em;
      color: #B8BFC4;
    }
    .meta-strip span + span::before {
      content: '·';
      margin: 0 8px;
      color: #DDE1E4;
    }

    /* Abstract */
    .lead {
      margin-top: 20px;
      font-size: 15px;
      font-weight: 400;
      letter-spacing: -0.006em;
      line-height: 1.74;
      color: #61686E;
    }

    /* Zielgruppen */
    .audience {
      margin-top: 16px;
      display: flex;
      flex-wrap: wrap;
      gap: 0;
    }
    .audience span {
      font-size: 10px;
      font-weight: 400;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: #C8CED2;
    }
    .audience span + span::before {
      content: '·';
      margin: 0 8px;
      color: #E2E5E8;
    }

    /* Link */
    .read-link {
      margin-top: 20px;
      display: inline-block;
      font-size: 13px;
      font-weight: 400;
      letter-spacing: -0.004em;
      color: #121517;
      text-decoration: none;
    }
    .read-link:hover { text-decoration: underline; text-underline-offset: 3px; }

    /* Trennlinie in Kachel */
    .card-divider {
      margin: 22px 0;
      height: 1px;
      background: #F2F4F5;
    }

    /* PDFs */
    .pdf-sublabel {
      font-size: 10px;
      font-weight: 400;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #C8CED2;
      margin-bottom: 12px;
    }
    .pdf-rows { display: flex; flex-direction: column; gap: 9px; }
    .pdf-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
    }
    .pdf-row a {
      font-size: 13px;
      font-weight: 400;
      letter-spacing: -0.005em;
      color: #121517;
      text-decoration: none;
    }
    .pdf-row a:hover { text-decoration: underline; text-underline-offset: 3px; }
    .pdf-row span {
      font-size: 12px;
      letter-spacing: 0.005em;
      color: #B8BFC4;
      white-space: nowrap;
    }

    /* ── Kontakt ─────────────────────────────────────────── */
    .contact { margin-top: 80px; }
    .contact-inner {
      display: flex;
      align-items: baseline;
      gap: 16px;
      margin-top: 16px;
    }
    .email {
      font-size: 15px;
      font-weight: 400;
      letter-spacing: -0.007em;
      color: #121517;
      text-decoration: none;
    }
    .email:hover { text-decoration: underline; text-underline-offset: 3px; }

    @media (max-width: 639px) {
      .name { font-size: 44px; }
      .t1, .t2 { font-size: 20px; }
      .t2 { margin-left: 0; }
    }
  </style>
</head>
<body>
<div class="wrap">

  <!-- Kopfzeile -->
  <div class="head s0">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
      <defs><linearGradient id="sgd" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#D6DCE0"/>
        <stop offset="45%" stop-color="#6E777E"/>
        <stop offset="100%" stop-color="#AAB2B8"/>
      </linearGradient></defs>
      <path d="M10 3 L16.5 14 H3.5 Z" stroke="url(#sgd)" stroke-width="1.4" stroke-linejoin="round" fill="none"/>
      <line x1="2" y1="17" x2="18" y2="17" stroke="url(#sgd)" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
    <nav class="lang" aria-label="Sprache">
      <a href="/v1d/" class="on">DE</a><span class="lang-sl" aria-hidden="true">/</span><a href="/en/">EN</a>
    </nav>
  </div>

  <!-- Symbol als eigene Zone -->
  <div class="symbol-zone s1" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" width="26" height="26" fill="none">
      <defs><linearGradient id="sgd2" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#D6DCE0"/>
        <stop offset="45%" stop-color="#6E777E"/>
        <stop offset="100%" stop-color="#AAB2B8"/>
      </linearGradient></defs>
      <path d="M10 3 L16.5 14 H3.5 Z" stroke="url(#sgd2)" stroke-width="1.4" stroke-linejoin="round" fill="none"/>
      <line x1="2" y1="17" x2="18" y2="17" stroke="url(#sgd2)" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
  </div>

  <!-- Intro -->
  <h1 class="name s2">Henrik Asmus</h1>
  <p class="tagline s2">Student des Wirtschaftsingenieurwesens. Neugierig.</p>
  <p class="thesis-spec s2" aria-label="Thesis: 12 Kriterien, 2 Zustände">
    <span>12 Kriterien</span>
    <span>2 Zustände</span>
    <span>Ethereum</span>
  </p>

  <!-- Arbeiten -->
  <div class="werk s3">
    <div class="werk-header">
      <span class="sec-label">Arbeiten</span>
      <span class="werk-year">2026</span>
    </div>

    <div class="werk-card">
      <div class="card-inner">
        <!-- Titel mit Laufnummer -->
        <div class="title-row">
          <span class="work-index" aria-hidden="true">01</span>
          <span class="t1">Lastannahmen</span>
        </div>
        <span class="t2">Ethereum als fundamentale digitale Infrastruktur</span>

        <!-- Meta -->
        <div class="meta-strip">
          <span>Masterarbeit</span>
          <span>Eigenverlag</span>
          <span>Juli 2026</span>
          <span>324 Seiten</span>
        </div>

        <!-- Abstract -->
        <p class="lead">Die Arbeit prüft Ethereum an zwölf Kriterien für fundamentale Infrastruktur, in zwei Zuständen: im heutigen, Stand März 2026, und in dem, der sich bei vollständig umgesetzter Roadmap ergäbe. Sie ist an keiner Hochschule eingereicht.</p>

        <!-- Zielgruppen -->
        <div class="audience" aria-label="Geschrieben für">
          <span>Entscheider</span>
          <span>Kapitalgeber</span>
          <span>Architekten</span>
          <span>Politik</span>
        </div>

        <a class="read-link" href="/lastannahmen/">Zur Arbeit →</a>

        <div class="card-divider" aria-hidden="true"></div>

        <p class="pdf-sublabel">Verfügbar als</p>
        <div class="pdf-rows">
          <div class="pdf-row">
            <a href="/pdf/Lastannahmen.pdf">Lastannahmen.pdf</a>
            <span>Deutsch · 324 Seiten</span>
          </div>
          <div class="pdf-row">
            <a href="/pdf/Load-Assumptions.pdf">Load-Assumptions.pdf</a>
            <span>English · 299 pages</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Kontakt -->
  <div class="contact s4">
    <span class="sec-label">Kontakt</span>
    <div class="contact-inner">
      <a class="email" href="mailto:HenrikAsmus@proton.me">HenrikAsmus@proton.me</a>
    </div>
  </div>

</div>
</body>
</html>
