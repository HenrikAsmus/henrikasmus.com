---
// V1C — "Schichtung": Reiche Typografie-Schichtung, 760px. Name groß, Untertitel
// als Tagline, Abstract als eigenständige Text-Zone, PDFs prominent als Cards.
// Stärker gestaffelter Einstieg, mehr visuelle Dichte.
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Henrik Asmus — V1C</title>
  <link rel="stylesheet" href="/styles/global.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    .wrap {
      max-width: 760px;
      margin: 0 auto;
      padding: 52px 28px 160px;
      font-family: 'Geist', Inter, system-ui, sans-serif;
      color: #121517;
    }

    @media (prefers-reduced-motion: no-preference) {
      @keyframes fi { from { opacity: 0; } to { opacity: 1; } }
      .s0 { animation: fi 400ms ease both; }
      .s1 { animation: fi 400ms 70ms ease both; }
      .s2 { animation: fi 400ms 160ms ease both; }
      .s3 { animation: fi 400ms 260ms ease both; }
      .s4 { animation: fi 400ms 360ms ease both; }
      .s5 { animation: fi 400ms 460ms ease both; }
    }

    /* Header */
    .head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 80px;
    }
    .lang {
      font-size: 11px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      display: flex;
      align-items: center;
    }
    .lang a { color: #B0B8BD; text-decoration: none; }
    .lang a.on { color: #121517; }
    .lang a:hover { color: #121517; }
    .lang-sl { color: #E0E4E7; margin: 0 7px; }

    /* Intro */
    .name {
      font-size: 56px;
      font-weight: 500;
      letter-spacing: -0.036em;
      line-height: 1.0;
      color: #121517;
    }

    /* Tagline — eigene Zone, größer als in V1 */
    .tagline {
      margin-top: 20px;
      font-size: 18px;
      font-weight: 400;
      letter-spacing: -0.010em;
      line-height: 1.45;
      color: #8A9197;
    }

    /* Werk */
    .werk { margin-top: 96px; }

    .werk-header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      margin-bottom: 20px;
    }
    .sec-label {
      font-size: 10.5px;
      font-weight: 400;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #C8CED2;
    }
    .werk-year {
      font-size: 12px;
      font-weight: 400;
      letter-spacing: 0;
      color: #C8CED2;
    }

    /* Kachel */
    .werk-card {
      border: 1px solid #ECEEF0;
      border-radius: 10px;
      padding: 28px 28px 24px;
    }

    .t1 {
      display: block;
      font-size: 24px;
      font-weight: 500;
      letter-spacing: -0.032em;
      line-height: 1.2;
      color: #121517;
    }
    .t2 {
      display: block;
      font-size: 24px;
      font-weight: 500;
      letter-spacing: -0.032em;
      line-height: 1.2;
      background: linear-gradient(100deg, #78828A 0%, #C3CACF 50%, #78828A 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    /* Meta-Streifen */
    .meta-strip {
      margin-top: 16px;
      display: flex;
      flex-wrap: wrap;
      gap: 0;
    }
    .meta-strip span {
      font-size: 12px;
      font-weight: 400;
      letter-spacing: 0.005em;
      color: #B8BFC4;
    }
    .meta-strip span + span::before {
      content: '·';
      margin: 0 8px;
      color: #DDE1E4;
    }

    /* Lead-Absatz */
    .lead {
      margin-top: 24px;
      font-size: 15px;
      font-weight: 400;
      letter-spacing: -0.006em;
      line-height: 1.72;
      color: #61686E;
    }

    /* Zur-Arbeit-Link */
    .read-link {
      margin-top: 20px;
      display: inline-block;
      font-size: 13px;
      font-weight: 400;
      letter-spacing: -0.004em;
      color: #121517;
      text-decoration: none;
    }
    .read-link:hover { text-decoration: underline; text-underline-offset: 3px; }

    /* Trennlinie innerhalb der Kachel */
    .card-divider {
      margin: 24px 0;
      height: 1px;
      background: #F2F4F5;
    }

    /* PDF-Zeilen innerhalb der Kachel */
    .pdf-sublabel {
      font-size: 10px;
      font-weight: 400;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #C8CED2;
      margin-bottom: 14px;
    }
    .pdf-rows {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .pdf-row {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
    }
    .pdf-row a {
      font-size: 13px;
      font-weight: 400;
      letter-spacing: -0.005em;
      color: #121517;
      text-decoration: none;
    }
    .pdf-row a:hover { text-decoration: underline; text-underline-offset: 3px; }
    .pdf-row span {
      font-size: 12px;
      letter-spacing: 0.005em;
      color: #B8BFC4;
      white-space: nowrap;
    }

    /* Kontakt */
    .contact { margin-top: 80px; }
    .email {
      margin-top: 20px;
      display: inline-block;
      font-size: 15px;
      font-weight: 400;
      letter-spacing: -0.007em;
      color: #121517;
      text-decoration: none;
    }
    .email:hover { text-decoration: underline; text-underline-offset: 3px; }

    @media (max-width: 639px) {
      .name { font-size: 38px; }
      .tagline { font-size: 16px; }
      .t1, .t2 { font-size: 20px; }
      .pdf-cards { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
<div class="wrap">
  <div class="head s0">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
      <defs><linearGradient id="sgc" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#D6DCE0"/><stop offset="45%" stop-color="#6E777E"/><stop offset="100%" stop-color="#AAB2B8"/>
      </linearGradient></defs>
      <path d="M10 3 L16.5 14 H3.5 Z" stroke="url(#sgc)" stroke-width="1.4" stroke-linejoin="round" fill="none"/>
      <line x1="2" y1="17" x2="18" y2="17" stroke="url(#sgc)" stroke-width="1.4" stroke-linecap="round"/>
    </svg>
    <nav class="lang" aria-label="Sprache">
      <a href="/v1c/" class="on">DE</a><span class="lang-sl" aria-hidden="true">/</span><a href="/en/">EN</a>
    </nav>
  </div>

  <h1 class="name s1">Henrik Asmus</h1>
  <p class="tagline s2">Student des Wirtschaftsingenieurwesens. Neugierig.</p>

  <div class="werk s3">
    <div class="werk-header">
      <span class="sec-label">Arbeiten</span>
      <span class="werk-year">2026</span>
    </div>
    <div class="werk-card">
      <span class="t1">Lastannahmen</span>
      <span class="t2">Ethereum als fundamentale digitale Infrastruktur</span>
      <div class="meta-strip">
        <span>Masterarbeit</span>
        <span>Eigenverlag</span>
        <span>Juli 2026</span>
        <span>324 Seiten</span>
      </div>
      <p class="lead">Die Arbeit prüft Ethereum an zwölf Kriterien für fundamentale Infrastruktur, in zwei Zuständen: im heutigen, Stand März 2026, und in dem, der sich bei vollständig umgesetzter Roadmap ergäbe. Sie ist an keiner Hochschule eingereicht. Geschrieben für Entscheider in Unternehmen, Kapitalgeber, technische Architekten und Politik, nicht für die Szene.</p>
      <a class="read-link" href="/lastannahmen/">Zur Arbeit →</a>
      <div class="card-divider" aria-hidden="true"></div>
      <p class="pdf-sublabel">Verfügbar als</p>
      <div class="pdf-rows">
        <div class="pdf-row">
          <a href="/pdf/Lastannahmen.pdf">Lastannahmen.pdf</a>
          <span>Deutsch · 324 Seiten</span>
        </div>
        <div class="pdf-row">
          <a href="/pdf/Load-Assumptions.pdf">Load-Assumptions.pdf</a>
          <span>English · 299 pages</span>
        </div>
      </div>
    </div>
  </div>

  <div class="contact s4">
    <span class="sec-label">Kontakt</span>
    <a class="email" href="mailto:HenrikAsmus@proton.me">HenrikAsmus@proton.me</a>
  </div>
</div>
</body>
</html>
