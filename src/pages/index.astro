---
---
<!doctype html>
<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Henrik Asmus</title>
  <link rel="canonical" href="https://henrikasmus.com/" />
  <link rel="alternate" hreflang="de" href="https://henrikasmus.com/" />
  <link rel="alternate" hreflang="en" href="https://henrikasmus.com/en/" />
  <link rel="alternate" hreflang="x-default" href="https://henrikasmus.com/" />
  <link rel="stylesheet" href="/styles/global.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* ── Site bar ── */
    .site-bar {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      padding: 14px 40px;
      background: rgba(255,255,255,0.96);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-bottom: 1px solid transparent;
      transition: border-color 0.2s;
    }
    .site-bar.scrolled { border-bottom-color: var(--c-divider); }
    @media (max-width: 639px) { .site-bar { padding: 14px 20px; } }

    /* ── Page wrapper ── */
    .hw {
      max-width: 960px;
      margin: 0 auto;
      padding: 52px 40px 160px;
      font-family: 'Geist', Inter, system-ui, sans-serif;
      color: var(--c-text);
    }
    @media (max-width: 639px) { .hw { padding: 36px 20px 120px; } }

    @media (prefers-reduced-motion: no-preference) {
      @keyframes fi { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
      .s1 { animation: fi 500ms 0ms ease both; }
      .s3 { animation: fi 500ms 160ms ease both; }
      .s4 { animation: fi 500ms 260ms ease both; }
    }

    /* ── Hero: asymmetric split grid ── */
    .hero {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0 56px;
      align-items: center;
      border: 1px solid var(--c-divider);
      padding: 52px 48px;
      margin-bottom: 64px;
    }
    @media (max-width: 700px) {
      .hero { grid-template-columns: 1fr; gap: 28px 0; padding: 36px 28px; }
    }
    @media (max-width: 440px) { .hero { padding: 28px 20px; } }

    .name {
      font-family: 'Pinyon Script', cursive;
      font-size: 80px;
      font-weight: 400;
      line-height: 1.0;
      letter-spacing: 0.01em;
      color: var(--c-text);
    }
    @media (max-width: 700px) { .name { font-size: 68px; } }
    @media (max-width: 440px) { .name { font-size: 56px; } }

    .hero-right {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .hero-tag {
      display: block;
      font-family: ui-monospace, 'SF Mono', 'Courier New', Courier, monospace;
      font-size: 10px;
      letter-spacing: 0.05em;
      color: var(--c-meta);
      margin-bottom: 14px;
    }

    .tagline {
      font-size: 14px;
      letter-spacing: -0.005em;
      line-height: 1.68;
      color: var(--c-sub);
    }

    /* ── Section label ── */
    .sec-label {
      display: block;
      font-size: 9.5px;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      color: var(--c-meta);
      margin-bottom: 0;
    }

    /* ── Work section ── */
    .werk-section { margin-bottom: 72px; }

    .werk-entry {
      border-top: 1px solid var(--c-divider);
      padding-top: 28px;
      margin-top: 28px;
    }

    .wt1, .wt2 {
      display: block;
      font-size: 23px;
      font-weight: 500;
      letter-spacing: -0.03em;
      line-height: 1.20;
    }
    .wt1 { color: var(--c-text); }
    .wt2 { color: var(--c-sub); }
    @media (max-width: 639px) { .wt1, .wt2 { font-size: 19px; } }

    .werk-meta {
      margin-top: 12px;
      font-size: 11.5px;
      letter-spacing: 0.002em;
      color: var(--c-meta);
    }

    .werk-desc {
      margin-top: 14px;
      font-size: 14px;
      letter-spacing: -0.005em;
      line-height: 1.72;
      color: var(--c-body);
      max-width: 500px;
    }

    .werk-actions {
      margin-top: 22px;
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 6px 28px;
    }

    .werk-read {
      font-size: 13px;
      letter-spacing: -0.004em;
      color: var(--c-text);
      text-decoration: none;
    }
    .werk-read:hover { text-decoration: underline; text-underline-offset: 3px; }

    .werk-pdfs { display: flex; gap: 16px; flex-wrap: wrap; }
    .werk-pdf-a {
      font-size: 12px;
      letter-spacing: -0.002em;
      color: var(--c-meta);
      text-decoration: none;
    }
    .werk-pdf-a:hover { color: var(--c-sub); }

    /* ── Contact ── */
    .contact-section {
      border-top: 1px solid var(--c-divider);
      padding-top: 28px;
    }

    .contact-label {
      display: block;
      font-size: 9.5px;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      color: var(--c-meta);
      margin-bottom: 12px;
    }

    .contact-email {
      display: inline-block;
      font-size: 14px;
      letter-spacing: -0.006em;
      color: var(--c-text);
      text-decoration: none;
    }
    .contact-email:hover { text-decoration: underline; text-underline-offset: 3px; }
  </style>
</head>
<body>

<div class="site-bar" id="site-bar">
  <nav class="lang-switcher" aria-label="Sprache">
    <a href="/" class="active" aria-current="page">DE</a>
    <span class="slash" aria-hidden="true">/</span>
    <a href="/en/">EN</a>
  </nav>
</div>

<div class="hw">
  <div class="hero s1">
    <h1 class="name">Henrik Asmus</h1>
    <div class="hero-right">
      <span class="hero-tag">// Wirtschaftsingenieurwesen</span>
      <p class="tagline">Forschung an Technologie,<br>Infrastruktur und Kapital.</p>
    </div>
  </div>

  <section class="werk-section s3" aria-label="Arbeiten">
    <span class="sec-label">Arbeiten</span>
    <div class="werk-entry">
      <span class="wt1">Lastannahmen</span>
      <span class="wt2">Ethereum als fundamentale digitale Infrastruktur</span>
      <p class="werk-meta">Masterarbeit · Eigenverlag · Juli 2026 · 324 Seiten</p>
      <p class="werk-desc">Die Arbeit prüft Ethereum an zwölf Kriterien für fundamentale Infrastruktur, in zwei Zuständen: im heutigen, Stand März 2026, und in dem, der sich bei vollständig umgesetzter Roadmap ergäbe. Geschrieben für Entscheider in Unternehmen, Kapitalgeber, technische Architekten und Politik.</p>
      <div class="werk-actions">
        <a href="/lastannahmen/" class="werk-read">Online lesen →</a>
        <div class="werk-pdfs">
          <a href="/pdf/Lastannahmen.pdf" class="werk-pdf-a">PDF · Deutsch ↓</a>
          <a href="/pdf/Load-Assumptions.pdf" class="werk-pdf-a">PDF · English ↓</a>
        </div>
      </div>
    </div>
  </section>

  <section class="contact-section s4" id="kontakt" aria-label="Kontakt">
    <span class="contact-label">Kontakt</span>
    <a href="mailto:HenrikAsmus@proton.me" class="contact-email">HenrikAsmus@proton.me</a>
  </section>
</div>

<script is:inline>
  window.addEventListener('scroll', function () {
    var bar = document.getElementById('site-bar');
    if (bar) bar.classList.toggle('scrolled', window.scrollY > 16);
  }, { passive: true });
</script>
</body>
</html>
