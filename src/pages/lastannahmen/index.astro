---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const alle = await getCollection('kapitel');
const kapitel = alle
  .filter(e => e.id.startsWith('de/'))
  .sort((a, b) => a.data.nummer - b.data.nummer)
  .map(e => ({
    ...e,
    slug: e.id.replace(/^de\/\d+-/, '').replace(/\.md$/, ''),
  }));
---
<Layout
  title="Lastannahmen"
  lang="de"
  canonicalDE="/lastannahmen/"
  canonicalEN="/en/load-assumptions/"
  overview
>
  <div class="werk-block">
    <span class="werk-titel-1">Lastannahmen</span>
    <span class="werk-titel-2">Ethereum als fundamentale digitale Infrastruktur</span>
    <p class="meta">Masterarbeit · Eigenverlag · Juli 2026 · 324 Seiten</p>
  </div>

  <div class="tab-bar" role="tablist">
    <button class="tab-btn tab-active" role="tab" data-tab="kapitel">Kapitelübersicht</button>
    <button class="tab-btn" role="tab" data-tab="pdf-de">PDF Deutsch</button>
    <button class="tab-btn" role="tab" data-tab="pdf-en">PDF Englisch</button>
  </div>

  <div class="tab-panel tab-active" id="tab-kapitel">
    <nav class="verzeichnis verzeichnis-grid" aria-label="Kapitelübersicht">
      {kapitel.map(k => (
        <a href={`/lastannahmen/${k.slug}/`} class="verzeichnis-eintrag">
          <span class="verzeichnis-label">
            {k.data.nummer === 0 ? 'Vorwort' : `Kapitel ${k.data.nummer}`}
          </span>
          <span class="verzeichnis-name">{k.data.titel}</span>
          <p class="verzeichnis-befund">{k.data.befund}</p>
        </a>
      ))}
    </nav>
  </div>

  <div class="tab-panel" id="tab-pdf-de">
    <div class="pdf-dl-cards">
      <a href="/pdf/Lastannahmen.pdf" class="pdf-dl-card">
        <span class="pdf-dl-lang">Deutsch</span>
        <span class="pdf-dl-name">Lastannahmen.pdf</span>
        <span class="pdf-dl-meta">324 Seiten · 1,1 MB</span>
      </a>
    </div>
  </div>

  <div class="tab-panel" id="tab-pdf-en">
    <div class="pdf-dl-cards">
      <a href="/pdf/Load-Assumptions.pdf" class="pdf-dl-card">
        <span class="pdf-dl-lang">English</span>
        <span class="pdf-dl-name">Load-Assumptions.pdf</span>
        <span class="pdf-dl-meta">299 pages · 1.0 MB</span>
      </a>
    </div>
  </div>

  <p class="back-link"><a href="/">← Henrik Asmus</a></p>

  <script is:inline>
    (function () {
      var btns = document.querySelectorAll('.tab-btn');
      var panels = document.querySelectorAll('.tab-panel');
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var id = btn.dataset.tab;
          btns.forEach(function (b) { b.classList.remove('tab-active'); });
          panels.forEach(function (p) { p.classList.remove('tab-active'); });
          btn.classList.add('tab-active');
          var panel = document.getElementById('tab-' + id);
          if (panel) panel.classList.add('tab-active');
        });
      });
    })();
  </script>
</Layout>
